<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<!--
    Fenster zum Zurücksetzen von Passwörtern.Nur für Admins(Super-User) zugänglich. (Siehe User Story)

    Felder:
    - Benutzername: wessen Passwort zurückgesetzt werden soll
    - Neues Passwort: das neue Passwort
    - Passwort bestätigen: zur Sicherheit nochmal eingeben
-->
<VBox alignment="CENTER" prefHeight="320.0" prefWidth="420.0" spacing="12.0"
      stylesheets="@Application.css"
      xmlns="http://javafx.com/javafx/10.0.2-internal"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.hitec.nhplus.controller.PasswordResetController">
    <padding>
        <Insets bottom="40.0" left="60.0" right="60.0" top="40.0"/>
    </padding>
    <children>
        <!-- Titel -->
        <Label text="Passwort zurücksetzen"/>

        <!-- Benutzername eingeben -->
        <TextField fx:id="textFieldUsername" promptText="Benutzername"/>

        <!-- neues Passwort (wird als Punkte angezeigt) -->
        <PasswordField fx:id="passwordFieldNew" promptText="Neues Passwort"/>

        <!-- Passwort nochmals hier eingeben zur Bestätigung -->
        <PasswordField fx:id="passwordFieldConfirm" promptText="Passwort bestätigen"/>

        <!-- Button zum Zurücksetzen -->
        <Button maxWidth="Infinity" text="Zurücksetzen" onAction="#handleReset"/>

        <!-- Fenster schließen -->
        <Button maxWidth="Infinity" text="Schließen" onAction="#handleClose"/>

        <!-- hat geklappt oder Fehlermeldung -->
        <Label fx:id="labelResult" text="" visible="false" wrapText="true"/>
    </children>
</VBox>